---
import '../styles/library.css';
const title = 'Private Academic Library — RJ Dasein';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f5f2ec" />
    <meta name="description" content="A private academic library for literature, reading notes and connections." />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="library-shell">
      <header class="library-header">
        <a class="library-brand" href="/">RJ<span>.</span> / Library</a>
        <div class="header-right">
          <a class="home-link" href="/">返回网站 ↗</a>
          <span>PRIVATE SPACE</span>
        </div>
      </header>
      <main><slot /></main>
      <footer class="library-footer">
        <span>RJ Dasein · Private Academic Library</span>
        <span>Literature · Embodiment · Movement · Meaning</span>
      </footer>
    </div>
  </body>
</html>
