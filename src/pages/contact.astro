---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Ruijie Wu" description="Contact Ruijie Wu about psychotherapy, workshops, teaching and collaboration.">
  <section class="page-intro container">
    <span class="eyebrow">Contact</span>
    <h1>Begin with<br /><em>a conversation.</em></h1>
    <p class="lede">For enquiries about therapeutic work, workshops, teaching, writing or collaboration, you are welcome to get in touch.</p>
  </section>
  <section class="container">
    <div class="contact-panel">
      <span class="eyebrow">Write to me</span>
      <h2>Some things begin with a simple hello.</h2>
      <p class="prose">Tell me a little about what brings you here and what you have in mind.</p>
      <a class="text-link" href="mailto:hello@rjdasein.com">hello@rjdasein.com <span>↗</span></a>
    </div>
  </section>
</BaseLayout>
